generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ───── 사용자 (인증은 Supabase Auth가 관리) ─────
// id 는 Supabase auth.users 의 UUID 와 동일 값을 사용한다.
// 비밀번호/세션/이메일 인증은 Supabase Auth 가 처리하므로 여기서 보관하지 않는다.
model User {
  id            String    @id
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile UserProfile?
}

// ───── 사용자 프로필 ─────
model UserProfile {
  userId        String    @id
  username      String    @unique
  princessName  String?
  birthDate     DateTime?
  birthTime     String?
  mbti          String?
  avatarUrl     String?   @db.Text
  bio           String?   @db.Text
  ipCode        String?   @unique
  interests     String[]
  agreedTos     Boolean   @default(false)
  agreedPrivacy Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSecret {
  userId                String   @id
  openaiApiKeyEncrypted String?  @db.Text
  openaiKeyIv           String?
  openaiKeyTag          String?
  updatedAt             DateTime @updatedAt
}

// ───── 공주 시드 ─────
model Princess {
  id          String         @id
  displayName String
  avatarUrl   String?        @db.Text
  bio         String?        @db.Text
  personality Json
  inviteCode  String?        @unique
  isDefault   Boolean        @default(false)
  themeColor  String?
  createdAt   DateTime       @default(now())
  posts       PrincessPost[]
}

model PrincessPost {
  id         String   @id @default(cuid())
  princessId String
  imageUrl   String?  @db.Text
  imageUrls  String[] @default([])
  emoji      String?
  text       String   @db.Text
  comments   Json     @default("[]")
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  princess   Princess @relation(fields: [princessId], references: [id], onDelete: Cascade)

  @@index([princessId, position])
}

// ───── 2단계 stub 모델 ─────
// ───── 사용자 일기 ─────
model Post {
  id        String        @id @default(cuid())
  userId    String
  text      String        @db.Text
  imageUrl  String?
  createdAt DateTime      @default(now())
  comments  DiaryComment[]

  @@index([userId, createdAt])
}

model DiaryComment {
  id           String   @id @default(cuid())
  postId       String
  authorUserId String?              // 사용자가 단 댓글
  princessId   String?              // 공주가 단 댓글
  text         String   @db.Text
  parentId     String?              // 답글이면 부모 댓글 id
  createdAt    DateTime @default(now())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ───── DM ─────
model DirectMessageThread {
  id         String           @id @default(cuid())
  userId     String
  princessId String
  unread     Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   DirectMessage[]

  @@unique([userId, princessId])
  @@index([userId, updatedAt])
}

model DirectMessage {
  id        String              @id @default(cuid())
  threadId  String
  fromMe    Boolean
  text      String              @db.Text
  createdAt DateTime            @default(now())
  thread    DirectMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model UserPrincessRelation {
  userId           String
  princessId       String
  intimacy         Int       @default(0)
  lastInteractedAt DateTime?

  @@id([userId, princessId])
}

// ───── AI 메모리 (pgvector) ─────
// embedding 컬럼은 raw SQL로 추가됨 (prisma/migrations/vector.sql 참고)
model Memory {
  id         String   @id @default(cuid())
  userId     String
  princessId String?                // null이면 user 전반 메모리, 값이 있으면 그 공주에게만 보이는 메모리
  kind       String                 // 'diary', 'dm_user', 'dm_princess', 'persona_summary'
  text       String   @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, kind])
  @@index([userId, princessId])
}

model SafetyEvent {
  id         String   @id @default(cuid())
  userId     String
  princessId String?
  topic      String
  createdAt  DateTime @default(now())
}

model UploadedFile {
  id          String   @id @default(cuid())
  userId      String
  url         String
  size        Int
  contentType String
  createdAt   DateTime @default(now())
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

// ───── 캐릭터 (공주) 게시글에 대한 사용자 상호작용 ─────
model CharPostLike {
  userId    String
  charId    String
  postIdx   Int
  createdAt DateTime @default(now())

  @@id([userId, charId, postIdx])
  @@index([charId, postIdx])
}

model CharPostComment {
  id        String          @id @default(cuid())
  userId    String
  charId    String
  postIdx   Int
  text      String          @db.Text
  createdAt DateTime        @default(now())
  replies   CharPostReply[]

  @@index([userId, charId, postIdx])
  @@index([charId, postIdx, createdAt])
}

model CharPostReply {
  id         String   @id @default(cuid())
  commentId  String
  fromMe     Boolean
  princessId String?
  text       String   @db.Text
  createdAt  DateTime @default(now())
  comment    CharPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, createdAt])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
