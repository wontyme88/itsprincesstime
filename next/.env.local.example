# ───── Supabase ─────
# Supabase 콘솔 > Project Settings > Data API / API Keys 에서 복사

# DB 접속 (Prisma). Settings > Database > Connection string
#  - DATABASE_URL: 풀링(transaction) 포트 6543 사용, 끝에 ?pgbouncer=true
#  - DIRECT_URL: 마이그레이션용 직접 연결(5432)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# 클라이언트/SSR용 (Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 서버 전용 (Storage 업로드/관리). 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=""

# ───── App ─────
# 사용자별 OpenAI API 키 암호화용 (32 bytes base64).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

APP_BASE_URL="http://localhost:3000"

# (선택: 추후 기능용)
OPENAI_API_KEY=""
